# ==========================================
# GAMEWORLD BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# ==========================================
# APP CONFIGURATION
# ==========================================
NODE_ENV=development
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000

# ==========================================
# DATABASE - PostgreSQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gameworld_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=gameworld_db
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_MIGRATIONS_RUN=true

# Database connection string (alternative)
# DATABASE_URL=postgresql://gameworld_user:password@localhost:5432/gameworld_db

# ==========================================
# REDIS - Cache & Real-time
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT - Authentication
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=7776000

# ==========================================
# CORS - Cross-Origin Resource Sharing
# ==========================================
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# ==========================================
# STRIPE - Payment Processing
# ==========================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here
STRIPE_CURRENCY=EUR

# Pulse pricing (in EUR)
PULSE_PRICE_PER_UNIT=0.01
PULSE_MIN_WITHDRAWAL=50000
PULSE_CONVERSION_RATE=0.01

# ==========================================
# AWS S3 - File Storage
# ==========================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=gameworld-storage
AWS_S3_URL=https://gameworld-storage.s3.eu-west-1.amazonaws.com

# ==========================================
# EMAIL - SMTP Configuration
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@gameworld.io
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=GameWorld <noreply@gameworld.io>

# ==========================================
# SENDGRID - Alternative Email Service
# ==========================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@gameworld.io

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=./logs

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=http://localhost:3001
FRONTEND_DOMAIN=localhost

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_EMAIL=admin@gameworld.io
ADMIN_PASSWORD=admin_secure_password_change_this

# ==========================================
# FEATURE FLAGS
# ==========================================
FEATURE_LIVE_STREAMING=true
FEATURE_TEAMS=true
FEATURE_PULSE_CONVERSION=true
FEATURE_2FA=false
FEATURE_OAUTH=false

# ==========================================
# THIRD-PARTY SERVICES
# ==========================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Apple Sign-In
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_BUNDLE_ID=com.gameworld.app

# Twitch Integration (for live streaming)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ==========================================
# KYC - Know Your Customer (for withdrawals)
# ==========================================
KYC_THRESHOLD=5000
KYC_PROVIDER=veriff

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
SENTRY_DSN=https://your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
MIXPANEL_TOKEN=your_mixpanel_token

# ==========================================
# TWILIO - SMS & Phone Verification
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# SECURITY
# ==========================================
BCRYPT_ROUNDS=10
SESSION_TIMEOUT=3600000
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000

# ==========================================
# CRON JOBS
# ==========================================
CRON_ENABLED=true
CRON_TIMEZONE=Europe/Paris

# Daily challenges reset time (24h format)
DAILY_CHALLENGES_RESET_TIME=00:00

# ==========================================
# DEVELOPMENT ONLY
# ==========================================
DEBUG=gameworld:*
SEED_DATABASE=false
MOCK_STRIPE=false
