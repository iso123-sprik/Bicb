{\n  "name": "gameworld-backend\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Backend for GameWorld - Global Competition Platform\",\n  \"main\": \"dist/index.js\",\n  \"scripts\": {\n    \"dev\": \"ts-node-dev --respawn src/index.ts\",\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\",\n    \"test\": \"jest --coverage\",\n    \"test:watch\": \"jest --watch\",\n    \"lint\": \"eslint src --ext .ts\",\n    \"lint:fix\": \"eslint src --ext .ts --fix\",\n    \"typeorm\": \"typeorm-cli\",\n    \"migration:create\": \"typeorm migration:create src/database/migrations\",\n    \"migration:run\": \"typeorm migration:run -d src/database/data-source.ts\",\n    \"migration:revert\": \"typeorm migration:revert -d src/database/data-source.ts\",\n    \"seed\": \"ts-node src/database/seeds/index.ts\"\n  },\n  \"dependencies\": {\n    \"express\": \"^4.18.2\",\n    \"express-validator\": \"^7.0.0\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.3.1\",\n    \"bcryptjs\": \"^2.4.3\",\n    \"jsonwebtoken\": \"^9.1.0\",\n    \"pg\": \"^8.10.0\",\n    \"typeorm\": \"^0.3.17\",\n    \"redis\": \"^4.6.11\",\n    \"socket.io\": \"^4.7.2\",\n    \"stripe\": \"^14.5.0\",\n    \"axios\": \"^1.6.2\",\n    \"uuid\": \"^9.0.1\",\n    \"helmet\": \"^7.1.0\",\n    \"express-rate-limit\": \"^7.1.5\",\n    \"compression\": \"^1.7.4\",\n    \"morgan\": \"^1.10.0\",\n    \"joi\": \"^17.11.0\",\n    \"date-fns\": \"^2.30.0\",\n    \"class-validator\": \"^0.14.0\",\n    \"class-transformer\": \"^0.5.1\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/jest\": \"^29.5.8\",\n    \"@types/uuid\": \"^9.0.7\",\n    \"@types/bcryptjs\": \"^2.4.6\",\n    \"@types/jsonwebtoken\": \"^9.0.6\",\n    \"typescript\": \"^5.3.3\",\n    \"ts-node\": \"^10.9.2\",\n    \"ts-node-dev\": \"^2.0.0\",\n    \"jest\": \"^29.7.0\",\n    \"ts-jest\": \"^29.1.1\",\n    \"eslint\": \"^8.55.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.13.2\",\n    \"@typescript-eslint/parser\": \"^6.13.2\",\n    \"prettier\": \"^3.1.1\"\n  },\n  \"engines\": {\n    \"node\": \">=18.0.0\",\n    \"npm\": \">=9.0.0\"\n  }\n}\n